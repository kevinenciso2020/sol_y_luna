// Cloudflare Worker of the store (Astro SSR + static assets). See docs/DEPLOY.md.
// Secrets are NOT here: API_INTERNAL_URL and BFF_SHARED_SECRET are Worker secrets
// (`wrangler secret put`). PUBLIC_* values are inlined by Astro at build time (pnpm deploy).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sol-y-luna-web",
  "compatibility_date": "2026-11-01",
  // Astro sessions (cart guest token lives in its own cookie; this is Astro's session store).
  "kv_namespaces": [{ "binding": "SESSION", "id": "3be5be01012243ca84f810f1c6ec74a2" }],
  "observability": { "enabled": true },
}
