---
import { formatCOP, slugSchema } from '@sol-y-luna/shared';
import { PUBLIC_WHATSAPP_NUMBER } from 'astro:env/client';
import AgeGate from '../../components/store/AgeGate.astro';
import Breadcrumbs from '../../components/store/Breadcrumbs.astro';
import FolkBranch from '../../components/store/FolkBranch.astro';
import ProductCard from '../../components/store/ProductCard.astro';
import ProductMedia from '../../components/store/ProductMedia.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AGE_COOKIE, isAgeVerified } from '../../lib/age';
import {
  catalog,
  chipFor,
  NotFoundError,
  type ProductDetail,
  type PublicReview,
} from '../../lib/catalog';
import { imageUrl } from '../../lib/images';
import { productImage } from '../../lib/store-images';
import { whatsappLink } from '../../lib/whatsapp';

const slug = slugSchema.safeParse(Astro.params.slug);
if (!slug.success) return Astro.rewrite('/404');

let product: ProductDetail;
try {
  product = await catalog.product(slug.data);
} catch (error) {
  if (error instanceof NotFoundError) return Astro.rewrite('/404');
  throw error;
}

const ageVerified = isAgeVerified(Astro.cookies.get(AGE_COOKIE)?.value);
const gated = product.isAdult && !ageVerified;
// Reviews never block the page: if the call fails the section shows its empty state.
const reviews: PublicReview[] =
  gated || !product.rating
    ? []
    : await catalog
        .reviews(product.slug)
        .then((r) => r.data)
        .catch(() => []);
const rating = product.rating;
const ratingLabel = rating
  ? `${rating.average.toLocaleString('es-CO')} de 5 estrellas, ${rating.count} ${rating.count === 1 ? 'reseña' : 'reseñas'}`
  : '';
const reviewDate = new Intl.DateTimeFormat('es-CO', {
  dateStyle: 'long',
  timeZone: 'America/Bogota',
});
const site = Astro.site ?? new URL(Astro.url.origin);
const first = product.variants[0]!;
const chip = chipFor(product);
const images = product.images.length
  ? product.images
  : [{ id: 'fallback', publicId: '/placeholders/frasco.svg', alt: product.name, variantId: null }];
const ask = whatsappLink(PUBLIC_WHATSAPP_NUMBER, `Hola, quiero información sobre ${product.name}`);
const minPrice = Math.min(...product.variants.map((v) => v.retailPrice));
const maxPrice = Math.max(...product.variants.map((v) => v.retailPrice));
const absoluteImage = (publicId: string) =>
  publicId.startsWith('/') ? new URL(publicId, site).toString() : imageUrl(publicId, 1200);

const structuredData = gated
  ? undefined
  : {
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: product.name,
      description:
        product.seoDescription ?? product.shortDescription ?? product.description ?? undefined,
      image: images.map((i) => absoluteImage(i.publicId)),
      sku: first.sku,
      ...(product.brand ? { brand: { '@type': 'Brand', name: product.brand.name } } : {}),
      ...(product.category ? { category: product.category.name } : {}),
      ...(rating
        ? {
            aggregateRating: {
              '@type': 'AggregateRating',
              ratingValue: rating.average,
              reviewCount: rating.count,
              bestRating: 5,
              worstRating: 1,
            },
            review: reviews.slice(0, 5).map((r) => ({
              '@type': 'Review',
              author: { '@type': 'Person', name: r.authorName },
              datePublished: r.createdAt.slice(0, 10),
              reviewRating: { '@type': 'Rating', ratingValue: r.rating, bestRating: 5 },
              ...(r.comment ? { reviewBody: r.comment } : {}),
            })),
          }
        : {}),
      offers:
        product.variants.length > 1
          ? {
              '@type': 'AggregateOffer',
              priceCurrency: 'COP',
              lowPrice: minPrice,
              highPrice: maxPrice,
              offerCount: product.variants.length,
              availability: product.variants.some((v) => v.available > 0)
                ? 'https://schema.org/InStock'
                : 'https://schema.org/OutOfStock',
            }
          : {
              '@type': 'Offer',
              priceCurrency: 'COP',
              price: first.retailPrice,
              availability:
                first.available > 0
                  ? 'https://schema.org/InStock'
                  : 'https://schema.org/OutOfStock',
              url: new URL(`/productos/${product.slug}`, site).toString(),
              shippingDetails: {
                '@type': 'OfferShippingDetails',
                shippingRate: { '@type': 'MonetaryAmount', value: 0, currency: 'COP' },
                shippingDestination: { '@type': 'DefinedRegion', addressCountry: 'CO' },
              },
            },
    };

const crumbs = [
  { label: 'Inicio', href: '/' },
  product.category
    ? { label: product.category.name, href: `/categorias/${product.category.slug}` }
    : { label: 'Productos', href: '/productos' },
  { label: product.name },
];
const stockText = (n: number) =>
  n === 0 ? 'Agotado' : n <= 5 ? `Quedan ${n} unidades` : 'Disponible';
const sections = [
  { id: 'uso', title: 'Modo de uso', body: product.usage },
  { id: 'ingredientes', title: 'Ingredientes', body: product.ingredients },
  { id: 'advertencias', title: 'Advertencias', body: product.warnings },
].filter((s) => s.body);
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=60, stale-while-revalidate=300',
);
---

<BaseLayout
  title={
    gated
      ? 'Contenido para mayores de 18 años'
      : (product.seoTitle?.replace(/\s*\|\s*Sol y Luna Store$/, '') ?? product.name)
  }
  description={gated ? null : (product.seoDescription ?? product.shortDescription)}
  image={gated ? undefined : absoluteImage(images[0]!.publicId)}
  ogType="product"
  noindex={gated}
  structuredData={structuredData}
>
  {gated ? (
    <AgeGate
      returnTo={`/productos/${product.slug}`}
      error={
        Astro.url.searchParams.get('edad') === 'menor'
          ? 'Debes tener 18 años o más para ver este producto.'
          : null
      }
    />
  ) : (
    <>
      <div class="mx-auto max-w-6xl px-4 pt-2">
        <Breadcrumbs items={crumbs} />
      </div>
      <article class="mx-auto grid max-w-6xl gap-8 px-4 pt-4 md:grid-cols-2 md:gap-12 md:pt-8">
        <!-- Gallery -->
        <div class="relative md:sticky md:top-6 md:self-start">
          <FolkBranch class="pointer-events-none absolute -top-6 -left-8 size-28 sm:size-36" />
          <div data-gallery-main>
            <ProductMedia
              publicId={images[0]!.publicId}
              alt={images[0]!.alt}
              size="detail"
              eager
              sizes="(min-width: 768px) 45vw, 92vw"
            />
          </div>
          {images.length > 1 && (
            <ul class="mt-4 flex flex-wrap gap-2" aria-label="Más fotos">
              {images.map((img, i) => (
                <li>
                  <button
                    type="button"
                    data-gallery-thumb
                    data-src={productImage(img.publicId, 960).src}
                    data-alt={img.alt}
                    aria-pressed={i === 0 ? 'true' : 'false'}
                    class="size-16 overflow-hidden rounded-2xl bg-white ring-2 ring-luna/10 aria-pressed:ring-luna"
                  >
                    <img
                      src={productImage(img.publicId, 160).src}
                      alt={`Ver foto ${i + 1}: ${img.alt}`}
                      width="64"
                      height="64"
                      loading="lazy"
                      class="size-full object-contain p-1"
                    />
                  </button>
                </li>
              ))}
            </ul>
          )}
        </div>

        <!-- Buy box -->
        <div>
          <div class="flex flex-wrap items-center gap-2">
            {chip && (
              <span class="rounded-full bg-luna px-3 py-1 text-xs font-bold tracking-wide text-crema">
                {chip}
              </span>
            )}
            {product.isAdult && (
              <span class="rounded-full bg-noche px-3 py-1 text-xs font-bold text-crema">+18</span>
            )}
          </div>
          {product.brand && (
            <a
              href={`/marcas/${product.brand.slug}`}
              class="mt-4 inline-block font-semibold text-noche/80 underline-offset-4 hover:underline"
            >
              {product.brand.name}
            </a>
          )}
          <div class="mt-1 flex items-start justify-between gap-3">
            <h1 class="text-4xl sm:text-5xl">{product.name}</h1>
            <button
              type="button"
              data-wishlist
              data-product-id={product.id}
              data-login={`/cuenta/ingresar?next=${encodeURIComponent(`/productos/${product.slug}`)}`}
              aria-pressed="false"
              class="group grid size-12 shrink-0 place-items-center rounded-full border-2 border-luna text-luna hover:bg-luna-50 aria-pressed:bg-luna aria-pressed:text-crema"
            >
              <svg viewBox="0 0 24 24" class="size-6" aria-hidden="true">
                <path
                  d="M12 20.5s-7.5-4.6-9.3-9.2C1.4 8 3.6 4.5 7.1 4.5c2 0 3.6 1.1 4.9 2.8 1.3-1.7 2.9-2.8 4.9-2.8 3.5 0 5.7 3.5 4.4 6.8-1.8 4.6-9.3 9.2-9.3 9.2Z"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linejoin="round"
                  class="group-aria-pressed:fill-current"
                />
              </svg>
              <span class="sr-only" data-wishlist-label>
                Guardar en mi lista de deseos
              </span>
            </button>
          </div>
          {rating && (
            <a
              href="#resenas"
              class="mt-2 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-luna"
            >
              <span aria-hidden="true" class="text-lg tracking-wider text-sol-600">
                {'★'.repeat(Math.round(rating.average))}
                <span class="text-luna/25">{'★'.repeat(5 - Math.round(rating.average))}</span>
              </span>
              <span class="sr-only">{ratingLabel}</span>
              <span aria-hidden="true">
                {rating.average.toLocaleString('es-CO')} ({rating.count})
              </span>
            </a>
          )}
          {product.shortDescription && (
            <p class="mt-3 max-w-[48ch] text-lg text-noche/85">{product.shortDescription}</p>
          )}

          <div class="mt-6 flex flex-wrap items-baseline gap-x-3" aria-live="polite">
            <p class="font-display text-4xl font-black text-noche" data-price-display>
              {formatCOP(first.retailPrice)}
            </p>
            <p
              class:list={['text-lg text-noche/70 line-through', !first.compareAtPrice && 'hidden']}
              data-compare-display
            >
              <span class="sr-only">Antes</span>
              {first.compareAtPrice ? formatCOP(first.compareAtPrice) : ''}
            </p>
            <p class="w-full text-sm font-semibold text-luna" data-stock-display>
              {stockText(first.available)}
            </p>
          </div>
          <p
            hidden
            data-wholesale-display
            class="mt-3 rounded-2xl bg-luna-50 px-4 py-3 text-sm text-luna-800"
            aria-live="polite"
          ></p>

          <fieldset class="mt-6">
            <legend class="text-sm font-semibold">Presentación</legend>
            <div class="mt-2 flex flex-wrap gap-2">
              {product.variants.map((v, i) => (
                <label class="cursor-pointer">
                  <input
                    type="radio"
                    name="variante"
                    value={v.id}
                    checked={i === 0}
                    data-price={formatCOP(v.retailPrice)}
                    data-compare={v.compareAtPrice ? formatCOP(v.compareAtPrice) : ''}
                    data-stock={stockText(v.available)}
                    class="peer sr-only"
                  />
                  <span class="inline-flex min-h-11 items-center rounded-full border-2 border-luna px-4 text-sm font-semibold text-luna peer-checked:bg-luna peer-checked:text-crema peer-focus-visible:outline-3 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-sol-600">
                    {v.name}
                  </span>
                </label>
              ))}
            </div>
          </fieldset>

          <form class="mt-6 space-y-3" data-add-to-cart novalidate>
            <div class="flex flex-wrap items-end gap-3">
              <div>
                <label for="cantidad" class="block text-sm font-semibold">
                  Cantidad
                </label>
                <div class="mt-1 flex items-center rounded-full border-2 border-luna/25 bg-white">
                  <button
                    type="button"
                    data-qty-step="-1"
                    class="grid size-11 place-items-center rounded-full text-xl font-bold text-luna hover:bg-luna-50"
                    aria-label="Quitar una unidad"
                  >
                    −
                  </button>
                  <input
                    id="cantidad"
                    name="cantidad"
                    type="number"
                    inputmode="numeric"
                    min="1"
                    max="200"
                    value="1"
                    class="w-12 [appearance:textfield] bg-transparent text-center text-lg font-semibold outline-none [&::-webkit-inner-spin-button]:appearance-none"
                  />
                  <button
                    type="button"
                    data-qty-step="1"
                    class="grid size-11 place-items-center rounded-full text-xl font-bold text-luna hover:bg-luna-50"
                    aria-label="Agregar una unidad"
                  >
                    +
                  </button>
                </div>
              </div>
              <button
                type="submit"
                class="pill-cta min-h-12 flex-1 justify-center sm:flex-none"
                data-add-button
                disabled={first.available === 0}
              >
                {first.available === 0 ? 'Agotado' : 'Agregar al carrito'}
                <span aria-hidden="true">→</span>
              </button>
            </div>
            <p
              data-add-status
              role="status"
              aria-live="polite"
              class="text-sm font-medium empty:hidden"
            ></p>
            {ask && (
              <a
                href={ask}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-11 items-center font-semibold text-luna underline-offset-4 hover:underline"
              >
                ¿Dudas? Pregunta por WhatsApp
              </a>
            )}
          </form>

          <ul class="mt-6 flex flex-wrap gap-2 text-sm">
            <li class="pill-attr">Envío gratis</li>
            <li class="pill-attr">Empaque discreto</li>
            {product.variants.length === 1 && <li class="pill-attr">{first.name}</li>}
          </ul>

          <div class="mt-6 rounded-[1.5rem] bg-white p-4 ring-1 ring-luna/10">
            {product.invimaStatus === 'REGISTERED' && product.invimaCode ? (
              <p class="flex items-start gap-3">
                <span
                  class="grid size-10 shrink-0 place-items-center rounded-full bg-luna text-crema"
                  aria-hidden="true"
                >
                  ✓
                </span>
                <span>
                  <span class="block font-semibold">Registro INVIMA</span>
                  <span class="block text-sm text-noche/80">{product.invimaCode}</span>
                </span>
              </p>
            ) : (
              <p class="text-sm text-noche/80">
                <span class="font-semibold text-noche">Registro INVIMA: </span>
                {product.invimaStatus === 'IN_PROCESS'
                  ? 'en trámite.'
                  : product.invimaStatus === 'NOT_REQUIRED'
                    ? 'este producto no lo requiere.'
                    : 'este producto no tiene registro.'}
              </p>
            )}
          </div>

          {product.benefits.length > 0 && (
            <section aria-labelledby="beneficios" class="mt-8">
              <h2 id="beneficios" class="text-2xl">
                Beneficios
              </h2>
              <ul class="mt-3 space-y-2">
                {product.benefits.map((b) => (
                  <li class="flex gap-3">
                    <span class="mt-2 size-2.5 shrink-0 rounded-full bg-sol" aria-hidden="true" />
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {product.description && (
            <section aria-labelledby="descripcion" class="mt-8">
              <h2 id="descripcion" class="text-2xl">
                Descripción
              </h2>
              <p class="mt-3 max-w-[65ch] whitespace-pre-line">{product.description}</p>
            </section>
          )}

          {sections.length > 0 && (
            <div class="mt-8 divide-y divide-luna/15 border-y border-luna/15">
              {sections.map((s) => (
                <details class="group">
                  <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between font-display text-xl font-bold text-luna [&::-webkit-details-marker]:hidden">
                    {s.title}
                    <span
                      aria-hidden="true"
                      class="text-2xl transition-transform group-open:rotate-45"
                    >
                      +
                    </span>
                  </summary>
                  <p class="pb-4 whitespace-pre-line">{s.body}</p>
                </details>
              ))}
            </div>
          )}

          {product.disclaimer && (
            <p class="mt-6 rounded-[1.25rem] bg-crema-200 p-4 text-sm">{product.disclaimer}</p>
          )}
        </div>
      </article>

      <section aria-labelledby="resenas" class="mx-auto mt-16 max-w-6xl px-4">
        <h2 id="resenas" class="text-3xl">
          Reseñas
        </h2>
        {rating ? (
          <>
            <p class="mt-2 text-noche/80">
              {ratingLabel}. Solo opinan quienes compraron el producto y lo recibieron.
            </p>
            <ul class="mt-6 grid gap-4 md:grid-cols-2">
              {reviews.map((r) => (
                <li class="rounded-[1.5rem] bg-white p-5 ring-1 ring-luna/10">
                  <p class="text-lg tracking-wider text-sol-600" aria-hidden="true">
                    {'★'.repeat(r.rating)}
                    <span class="text-luna/25">{'★'.repeat(5 - r.rating)}</span>
                  </p>
                  <p class="sr-only">{r.rating} de 5 estrellas</p>
                  {r.title && <p class="mt-2 font-display text-xl font-bold">{r.title}</p>}
                  {r.comment && <p class="mt-2 break-words whitespace-pre-line">{r.comment}</p>}
                  <p class="mt-3 text-sm text-noche/75">
                    {r.authorName}
                    {r.verified && ' · Compra verificada'} ·{' '}
                    {reviewDate.format(new Date(r.createdAt))}
                  </p>
                </li>
              ))}
            </ul>
          </>
        ) : (
          <p class="mt-2 text-noche/80">
            Todavía no hay reseñas. Solo pueden opinar quienes compraron el producto y lo
            recibieron.
          </p>
        )}
      </section>

      {product.related.length > 0 && (
        <section aria-labelledby="relacionados" class="mx-auto mt-16 max-w-6xl px-4">
          <h2 id="relacionados" class="text-3xl">
            También te puede interesar
          </h2>
          <ul class="mt-6 grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-4">
            {product.related.map((p, i) => (
              <li>
                <ProductCard
                  product={p}
                  variant={i % 2 === 0 ? 'crema' : 'luna'}
                  ageVerified={ageVerified}
                />
              </li>
            ))}
          </ul>
        </section>
      )}
    </>
  )}
</BaseLayout>

<script>
  // Variant selector: updates price, previous price and stock text.
  const price = document.querySelector<HTMLElement>('[data-price-display]');
  const compare = document.querySelector<HTMLElement>('[data-compare-display]');
  const stock = document.querySelector<HTMLElement>('[data-stock-display]');
  document.querySelectorAll<HTMLInputElement>('input[name="variante"]').forEach((input) => {
    input.addEventListener('change', () => {
      if (price) price.textContent = input.dataset['price'] ?? '';
      if (stock) stock.textContent = input.dataset['stock'] ?? '';
      if (compare) {
        const value = input.dataset['compare'] ?? '';
        compare.lastChild!.textContent = value;
        compare.classList.toggle('hidden', !value);
      }
    });
  });

  // Add to cart.
  import { ApiError } from '../../lib/auth-client';
  import { cartApi, setCartCount } from '../../lib/cart-client';

  const form = document.querySelector<HTMLFormElement>('[data-add-to-cart]');
  const qty = form?.querySelector<HTMLInputElement>('input[name="cantidad"]');
  const addButton = form?.querySelector<HTMLButtonElement>('[data-add-button]');
  const status = form?.querySelector<HTMLElement>('[data-add-status]');
  const selected = () => document.querySelector<HTMLInputElement>('input[name="variante"]:checked');

  const syncAvailability = () => {
    const available = Number(selected()?.dataset['available'] ?? '0');
    if (!addButton || !qty) return;
    addButton.disabled = available === 0;
    addButton.firstChild!.textContent = available === 0 ? 'Agotado ' : 'Agregar al carrito ';
    qty.max = String(Math.max(1, Math.min(200, available)));
  };
  document
    .querySelectorAll<HTMLInputElement>('input[name="variante"]')
    .forEach((i) => i.addEventListener('change', syncAvailability));
  form?.querySelectorAll<HTMLButtonElement>('[data-qty-step]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!qty) return;
      const next = Number(qty.value || '1') + Number(button.dataset['qtyStep']);
      qty.value = String(Math.min(Number(qty.max || '200'), Math.max(1, next)));
    });
  });
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const variant = selected();
    if (!variant || !addButton || !status) return;
    addButton.disabled = true;
    status.className = 'text-sm font-medium empty:hidden';
    try {
      const cart = await cartApi.add(variant.value, Math.max(1, Number(qty?.value || '1')));
      setCartCount(cart.itemCount);
      sessionStorage.setItem('syl_cart_n', String(cart.itemCount));
      status.classList.add('text-luna');
      status.innerHTML =
        'Listo, lo agregamos. <a href="/carrito" class="font-bold underline">Ver carrito →</a>';
    } catch (error) {
      status.classList.add('text-sol-700');
      status.textContent =
        error instanceof ApiError ? error.message : 'No pudimos agregarlo. Intenta de nuevo.';
    } finally {
      syncAvailability();
    }
  });

  // Gallery thumbnails.
  const main = document.querySelector<HTMLImageElement>('[data-gallery-main] img');
  document.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]').forEach((thumb, _i, all) => {
    thumb.addEventListener('click', () => {
      if (!main) return;
      main.removeAttribute('srcset');
      main.src = thumb.dataset['src'] ?? main.src;
      main.alt = thumb.dataset['alt'] ?? main.alt;
      all.forEach((t) => t.setAttribute('aria-pressed', String(t === thumb)));
    });
  });
</script>

<script>
  // Signed-in extras, loaded in the browser so the page itself stays publicly cacheable:
  // the wishlist heart and, for approved wholesale accounts, the wholesale price.
  import { formatCOP } from '@sol-y-luna/shared';
  import { apiFetch } from '../../lib/auth-client';
  import { isSignedIn } from '../../lib/cart-client';

  const heart = document.querySelector<HTMLButtonElement>('[data-wishlist]');
  const heartLabel = heart?.querySelector<HTMLElement>('[data-wishlist-label]');
  const wholesale = document.querySelector<HTMLElement>('[data-wholesale-display]');
  const productId = heart?.dataset['productId'] ?? '';
  const setSaved = (saved: boolean) => {
    heart?.setAttribute('aria-pressed', String(saved));
    if (heartLabel)
      heartLabel.textContent = saved
        ? 'Quitar de mi lista de deseos'
        : 'Guardar en mi lista de deseos';
  };

  heart?.addEventListener('click', async () => {
    if (!isSignedIn()) {
      window.location.href = heart.dataset['login'] ?? '/cuenta/ingresar';
      return;
    }
    const saved = heart.getAttribute('aria-pressed') === 'true';
    setSaved(!saved);
    try {
      if (saved) await apiFetch(`/api/account/wishlist/${productId}`, { method: 'DELETE' });
      else
        await apiFetch('/api/account/wishlist', {
          method: 'POST',
          body: JSON.stringify({ productId }),
        });
    } catch {
      setSaved(saved);
    }
  });

  if (isSignedIn()) {
    apiFetch<{ data: string[] }>('/api/account/wishlist/ids')
      .then((res) => setSaved(res.data.includes(productId)))
      .catch(() => {});

    const slug = window.location.pathname.split('/').pop() ?? '';
    apiFetch<{
      data: {
        variants: { id: string; wholesalePrice: number | null; wholesaleMinQty: number | null }[];
      };
    }>(`/api/catalog/products/${encodeURIComponent(slug)}`)
      .then(({ data }) => {
        const byId = new Map(data.variants.map((v) => [v.id, v]));
        const show = () => {
          const id = document.querySelector<HTMLInputElement>(
            'input[name="variante"]:checked',
          )?.value;
          const v = id ? byId.get(id) : undefined;
          if (!wholesale) return;
          if (v?.wholesalePrice && v.wholesaleMinQty) {
            wholesale.textContent = `Precio mayorista: ${formatCOP(v.wholesalePrice)} c/u desde ${v.wholesaleMinQty} unidades. Se aplica solo al llegar a esa cantidad en el carrito.`;
            wholesale.hidden = false;
          } else wholesale.hidden = true;
        };
        document
          .querySelectorAll<HTMLInputElement>('input[name="variante"]')
          .forEach((i) => i.addEventListener('change', show));
        show();
      })
      .catch(() => {});
  }
</script>
