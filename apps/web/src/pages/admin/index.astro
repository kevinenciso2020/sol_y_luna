---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Dashboard from '../../components/admin/Dashboard';

const sections = [
  { href: '/admin/pedidos', title: 'Pedidos', text: 'Pagos, despachos, guías y reembolsos.' },
  {
    href: '/admin/productos',
    title: 'Productos',
    text: 'Presentaciones, precios, stock, imágenes e INVIMA.',
  },
  { href: '/admin/categorias', title: 'Categorías', text: 'Categorías, subcategorías y orden.' },
  { href: '/admin/marcas', title: 'Marcas', text: 'Páginas de marca y sus temas.' },
  { href: '/admin/cupones', title: 'Cupones', text: 'Descuentos por porcentaje o valor fijo.' },
  { href: '/admin/inventario', title: 'Inventario', text: 'Stock por presentación y ajustes.' },
  { href: '/admin/usuarios', title: 'Usuarios', text: 'Roles, operadores y clientes.' },
  {
    href: '/admin/comisiones',
    title: 'Comisiones',
    text: 'Porcentaje de la plataforma por regla.',
  },
  {
    href: '/admin/liquidaciones',
    title: 'Liquidaciones',
    text: 'Cortes por periodo, cierre, pago y CSV.',
  },
  {
    href: '/admin/configuracion',
    title: 'Configuración',
    text: 'Contacto, WhatsApp y textos legales.',
  },
  { href: '/admin/auditoria', title: 'Auditoría', text: 'Historial de cambios sensibles.' },
];
---

<AdminLayout title="Resumen">
  <h1 class="text-3xl sm:text-4xl">Hola, {Astro.locals.user!.name.split(' ')[0]}</h1>
  <div class="mt-6">
    <Dashboard client:only="preact" />
  </div>
  <h2 class="mt-12 font-display text-2xl text-luna">Secciones</h2>
  <ul class="mt-4 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
    {sections.map((s) => (
      <li>
        <a
          href={s.href}
          class="block h-full rounded-3xl bg-white p-6 ring-1 ring-luna/10 transition-shadow hover:ring-2 hover:ring-luna"
        >
          <span class="font-display text-2xl font-bold text-luna">{s.title}</span>
          <span class="mt-2 block text-sm text-noche/80">{s.text}</span>
        </a>
      </li>
    ))}
  </ul>
</AdminLayout>
