---
import Breadcrumbs from '../../components/store/Breadcrumbs.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { catalog } from '../../lib/catalog';

const brands = await catalog.brands();
---

<BaseLayout title="Marcas" description="Las marcas que encuentras en Sol y Luna Store.">
  <div class="mx-auto max-w-6xl px-4 pt-2">
    <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Marcas' }]} />
    <h1 class="mt-3 text-4xl sm:text-5xl">Marcas</h1>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {brands.map((b) => (
        <li>
          <a
            href={`/marcas/${b.slug}`}
            class:list={[
              'flex h-full flex-col rounded-[1.75rem] p-6 transition-transform hover:-translate-y-0.5',
              b.theme?.mode === 'dark' ? 'bg-[#0b0b12] text-white' : 'bg-white ring-1 ring-luna/10',
            ]}
          >
            <span
              class:list={[
                'font-display text-3xl font-black',
                b.theme?.mode === 'dark' ? 'text-[#c7ff9e]' : 'text-luna',
              ]}
            >
              {b.name}
            </span>
            {b.description && <span class="mt-2 text-sm opacity-85">{b.description}</span>}
            <span class="mt-4 text-sm font-semibold">{b.productCount ?? 0} productos →</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
