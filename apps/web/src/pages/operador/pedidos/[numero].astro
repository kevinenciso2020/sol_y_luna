---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import OrderDetail from '../../../components/admin/OrderDetail';

const numero = (Astro.params.numero ?? '').toUpperCase();
if (!/^SYL-\d{6,}$/.test(numero)) return Astro.redirect('/operador');
---

<AdminLayout title={`Pedido ${numero}`} area="operator">
  <OrderDetail client:only="preact" scope="operator" number={numero} />
</AdminLayout>
