---
import FormField from '../../components/FormField.astro';
import FormMessage from '../../components/FormMessage.astro';
import AccountShell from '../../components/account/AccountShell.astro';
import ProfileForm from '../../components/account/ProfileForm';
import SubmitButton from '../../components/SubmitButton.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

// The middleware guarantees a signed-in user here.
const user = Astro.locals.user!;
---

<BaseLayout title="Mi cuenta" noindex>
  <AccountShell title="Mi cuenta">
    {!user.emailVerified && (
      <div class="mb-8 rounded-2xl bg-sol-50 px-5 py-4 text-sol-900">
        <p class="font-semibold">Confirma tu correo</p>
        <p class="mt-1 text-sm">
          Te enviamos un enlace cuando creaste la cuenta. ¿No lo encuentras?
        </p>
        <button
          type="button"
          id="resend-verification"
          class="mt-3 font-semibold text-luna underline underline-offset-4"
        >
          Enviar el correo otra vez
        </button>
        <p id="resend-status" class="mt-2 text-sm" role="status" aria-live="polite" />
      </div>
    )}

    <ProfileForm client:only="preact" />

    <div class="mt-8 rounded-[2rem] bg-white p-6 ring-1 ring-luna/10 sm:p-8">
      <h2 class="text-2xl">Cambiar contraseña</h2>
      <p class="mt-1 text-sm text-noche/70">Cerramos tus sesiones en otros dispositivos.</p>
      <form id="change-password-form" class="mt-6 space-y-5" novalidate>
        <FormMessage />
        <FormField
          name="currentPassword"
          label="Contraseña actual"
          type="password"
          autocomplete="current-password"
        />
        <FormField
          name="newPassword"
          label="Nueva contraseña"
          type="password"
          autocomplete="new-password"
          minlength={10}
          hint="Mínimo 10 caracteres, con al menos una letra y un número."
        />
        <SubmitButton label="Cambiar contraseña" />
      </form>
    </div>
  </AccountShell>
</BaseLayout>

<script>
  import { ApiError, apiFetch } from '../../lib/auth-client';
  import { handleForm, setMessage } from '../../scripts/forms';

  const form = document.querySelector<HTMLFormElement>('#change-password-form');
  if (form) {
    handleForm(form, async (data) => {
      await apiFetch('/api/auth/change-password', { method: 'POST', body: JSON.stringify(data) });
      form.reset();
      setMessage(form, 'ok', 'Listo. Tu contraseña cambió y cerramos tus otras sesiones.');
    });
  }

  const resend = document.querySelector<HTMLButtonElement>('#resend-verification');
  const resendStatus = document.querySelector<HTMLElement>('#resend-status');
  resend?.addEventListener('click', async () => {
    resend.disabled = true;
    try {
      const result = await apiFetch<{ message: string }>('/api/auth/resend-verification', {
        method: 'POST',
      });
      if (resendStatus) resendStatus.textContent = result.message;
    } catch (error) {
      if (resendStatus)
        resendStatus.textContent = error instanceof ApiError ? error.message : 'Intenta de nuevo.';
      resend.disabled = false;
    }
  });
</script>
