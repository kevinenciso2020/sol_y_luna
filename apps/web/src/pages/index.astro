---
import { formatCOP } from '@sol-y-luna/shared';
import ProductPlaceholder from '../components/ProductPlaceholder.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

// Phase 0 preview: brand tokens and card variants. The real home arrives in phase 4.
const samples = [
  {
    name: 'Saúco Negro con Vitamina C y Zinc',
    chip: 'BIENESTAR',
    attr: '60 cápsulas',
    price: 89_900,
    variant: 'crema',
  },
  { name: 'Crema Neuropatía', chip: 'ALIVIO', attr: 'Uso tópico', price: 64_900, variant: 'luna' },
] as const;
---

<BaseLayout title="Sol y Luna Store">
  <section class="mx-auto max-w-6xl px-4 pt-6 pb-16">
    <h1 class="max-w-[14ch] text-5xl sm:text-7xl">Bienestar que llega a tu puerta</h1>
    <p class="mt-4 max-w-[52ch] text-lg">
      Estamos preparando la tienda. Muy pronto vas a encontrar aquí suplementos, cuidado íntimo,
      skincare y productos de bienestar, con envío gratis a toda Colombia.
    </p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {samples.map((item) => (
        <article
          class:list={[
            'relative overflow-hidden rounded-[2rem] p-6',
            item.variant === 'crema' ? 'bg-crema-50 ring-2 ring-luna' : 'bg-luna text-crema',
          ]}
        >
          {item.variant === 'luna' && (
            <div
              class="absolute -bottom-10 -left-10 size-48 rounded-[2.5rem] bg-sol"
              aria-hidden="true"
            />
          )}
          <span
            class:list={[
              'pill-chip absolute top-5 right-5',
              item.variant === 'luna' && 'bg-crema text-luna',
            ]}
          >
            {item.chip}
          </span>
          <ProductPlaceholder
            label={`Imagen provisional de ${item.name}`}
            class="relative mx-auto size-48"
          />
          <h2 class:list={['relative mt-4 text-2xl', item.variant === 'luna' && 'text-crema']}>
            {item.name}
          </h2>
          <p class="relative mt-2">
            <span class:list={['pill-attr', item.variant === 'luna' && 'border-crema text-crema']}>
              {item.attr}
            </span>
          </p>
          <p
            class:list={[
              'relative mt-4 font-display text-3xl font-black',
              item.variant === 'crema' ? 'text-luna' : 'text-crema',
            ]}
          >
            {formatCOP(item.price)}
          </p>
        </article>
      ))}
    </div>

    <p class="mt-10">
      <a
        href="https://www.instagram.com/solylunastore1/"
        class="pill-cta"
        rel="noopener noreferrer"
        target="_blank"
      >
        Síguenos en Instagram <span aria-hidden="true">→</span>
      </a>
    </p>
  </section>
</BaseLayout>
