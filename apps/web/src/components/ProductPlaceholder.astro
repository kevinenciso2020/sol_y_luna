---
/** Brand placeholder: bottle silhouette on an orange circle with an offset blue ring. */
interface Props {
  label: string;
  class?: string;
}
const { label, class: className = '' } = Astro.props;
---

<svg viewBox="0 0 200 200" role="img" aria-label={label} class={className}>
  <circle cx="100" cy="104" r="78" fill="#e9552e"></circle>
  <circle cx="110" cy="96" r="84" fill="none" stroke="#1747b5" stroke-width="5"></circle>
  <g fill="#fbf5ea">
    <rect x="82" y="44" width="36" height="16" rx="4"></rect>
    <rect x="70" y="62" width="60" height="100" rx="14"></rect>
  </g>
  <rect x="80" y="96" width="40" height="30" rx="4" fill="#1747b5"></rect>
</svg>
