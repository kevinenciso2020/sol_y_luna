---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  title: string;
  heading: string;
  intro?: string;
}
const { title, heading, intro } = Astro.props;
---

<BaseLayout title={title}>
  <section class="mx-auto grid max-w-5xl gap-8 px-4 pt-4 pb-16 lg:grid-cols-[1fr_1.1fr] lg:items-center">
    <div
      class="relative hidden overflow-hidden rounded-[2.5rem] bg-luna p-10 text-crema lg:block lg:min-h-[30rem]"
      aria-hidden="true"
    >
      <div class="absolute -right-16 -bottom-16 size-80 rounded-full bg-sol"></div>
      <div class="absolute -right-8 -bottom-24 size-96 rounded-full border-4 border-crema/70"></div>
      <p class="relative max-w-[16ch] font-display text-4xl leading-tight font-black">
        Tu bienestar, sin salir de casa.
      </p>
      <p class="relative mt-4 max-w-[30ch] text-crema/90">
        Envío gratis a toda Colombia y empaque discreto si lo pides.
      </p>
    </div>

    <div class="rounded-[2rem] bg-white p-6 shadow-[0_1px_0_#1747b51a] ring-1 ring-luna/10 sm:p-10">
      <h1 class="text-4xl">{heading}</h1>
      {intro && <p class="mt-3 text-noche/80">{intro}</p>}
      <div class="mt-8">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>
