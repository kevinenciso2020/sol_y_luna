---
/** Top-of-form status line. Filled by the form scripts. */
---

<p
  data-form-message
  role="status"
  aria-live="polite"
  class="hidden rounded-2xl px-4 py-3 text-sm font-medium data-[tone=error]:bg-sol-50 data-[tone=error]:text-sol-800 data-[tone=ok]:bg-luna-50 data-[tone=ok]:text-luna-800"
></p>
