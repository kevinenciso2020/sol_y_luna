# =============================================================================
# Sol y Luna Store — Web (apps/web/.env)
# Solo las variables con prefijo PUBLIC_ llegan al navegador. Aquí no van secretos
# de la API: la web habla con la API a través del BFF (/api/*) del mismo dominio.
# =============================================================================

# URL interna de la API a la que el BFF reenvía las peticiones (servidor a servidor).
API_INTERNAL_URL=http://localhost:4000

# URL pública de la web (canonical, Open Graph, sitemap).
PUBLIC_SITE_URL=http://localhost:4321

# Clave pública (site key) de Cloudflare Turnstile. Vacía = sin captcha fuera de producción.
PUBLIC_TURNSTILE_SITE_KEY=

# Número de WhatsApp con indicativo, solo dígitos (ej. 573001234567). Vacío = sin botón flotante.
PUBLIC_WHATSAPP_NUMBER=
