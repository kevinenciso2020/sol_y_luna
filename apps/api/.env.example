# =============================================================================
# Sol y Luna Store — API (apps/api/.env)
# Valores de EJEMPLO. Genera tus propios secretos; nunca reutilices estos.
# Las variables vacías activan el modo demo de cada integración.
# =============================================================================

# --- General -----------------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Base de datos (Neon, proyecto exclusivo de Sol y Luna) -------------------
# DATABASE_URL: conexión con pooler (host con "-pooler"), la usa la app.
DATABASE_URL=postgresql://usuario:clave@ep-ejemplo-pooler.us-east-2.aws.neon.tech/solyluna?sslmode=require
# DIRECT_URL: conexión directa (sin pooler), la usa Prisma para migraciones.
DIRECT_URL=postgresql://usuario:clave@ep-ejemplo.us-east-2.aws.neon.tech/solyluna?sslmode=require

# --- Autenticación y cifrado (OBLIGATORIOS) -----------------------------------
# Mínimo 32 caracteres. Genera con: openssl rand -base64 48
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-aleatorio-de-48-bytes
# Pepper para hashear refresh tokens. Genera con: openssl rand -base64 48
REFRESH_TOKEN_PEPPER=cambia-esto-por-otro-secreto-aleatorio-distinto
# Clave AES-256-GCM (32 bytes en base64) para cifrar tokens de Mercado Pago.
# Genera con: openssl rand -base64 32
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# --- URLs ---------------------------------------------------------------------
# Orígenes permitidos por CORS, separados por coma (nunca "*" en producción).
CORS_ORIGINS=http://localhost:4321
WEB_URL=http://localhost:4321
API_URL=http://localhost:4000

# --- Pagos ---------------------------------------------------------------------
# demo: siempre usa el proveedor simulado (mock).
# live: usa Mercado Pago y/o Wompi si sus credenciales están completas; si no, mock.
PAYMENTS_MODE=demo

# Mercado Pago. marketplace = split con OAuth del comercio; direct = sin split (pruebas).
MP_MODE=marketplace
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Solo para MP_MODE=direct (token de la cuenta que cobra).
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Clave secreta de notificaciones (Webhooks) del panel de Mercado Pago.
MP_WEBHOOK_SECRET=
# URL de retorno del OAuth (debe estar registrada en la app de Mercado Pago).
MP_REDIRECT_URI=http://localhost:4000/payments/mercadopago/oauth/callback

# Wompi (cuenta del cliente). Llaves en el panel de Wompi → Desarrolladores.
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# sandbox | production
WOMPI_ENV=sandbox

# --- Imágenes (Cloudinary). Vacío = placeholders locales y subida deshabilitada --
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sol-y-luna

# --- Emails (Resend). Vacío = los emails se escriben en el log ----------------
RESEND_API_KEY=
EMAIL_FROM="Sol y Luna Store <no-reply@example.com>"

# --- Anti-bot (Cloudflare Turnstile). Vacío = desactivado fuera de producción --
TURNSTILE_SECRET_KEY=

# --- Errores (Sentry, opcional) --------------------------------------------------
SENTRY_DSN=

# --- Usuarios del seed (solo los lee `pnpm db:seed`) ---------------------------
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=cambia-esta-clave-de-admin
OPERATOR_SEED_EMAIL=operador@example.com
OPERATOR_SEED_PASSWORD=cambia-esta-clave-de-operador
